{
  "name": "ha-webos-remote-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "volta": {
    "node": "22.23.3"
  },
  "scripts": {
    "build:assets": "node build.mjs",
    "build": "npm run build:assets && cf build",
    "typecheck": "tsc --noEmit",
    "preview": "npm run build:assets && cf dev",
    "check:deploy": "npm run typecheck && npm run build:assets && cf deploy --dry-run",
    "deploy": "npm run build:assets && cf deploy",
    "deployments": "cf workers deployments list --worker ha-webos-remote-site",
    "rollback": "cf workers deployments create --worker ha-webos-remote-site --strategy percentage"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.17",
    "typescript": "7.0.2",
    "wrangler": "4.150.0"
  }
}
